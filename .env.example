# Server
PORT=3001
# Comma-separated dashboard origins, or * (dev only)
CORS_ORIGIN=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
NODE_ENV=development

# Protect /admin/seed-demo and /admin/reset-db (required in production)
ADMIN_TOKEN=

# Deepgram STT
DEEPGRAM_API_KEY=

# Gemini scoring
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase (Auth + optional REST)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle / Postgres (required for db:push + seed + db:reset)
# Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=
# Or set password only (pooler URI auto-built; prefer full DATABASE_URL)
SUPABASE_DB_PASSWORD=

# Optional: skip live Deepgram/Gemini in local fixture demos
# Blocked when NODE_ENV=production unless ALLOW_DEMO_IN_PROD=true
DEMO_MODE=false
# ALLOW_DEMO_IN_PROD=false
