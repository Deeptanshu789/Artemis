# Server
PORT=3001
# Comma-separated dashboard origins, or * (dev only)
CORS_ORIGIN=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
NODE_ENV=development

# Protect /admin/seed-demo and /admin/reset-db (required in production)
ADMIN_TOKEN=

# Deepgram STT
DEEPGRAM_API_KEY=

# Mistral scoring — https://docs.mistral.ai/api/
# Console: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Optional: on Mistral failure, use heuristic demo scores instead of failing the session
# SCORING_FALLBACK_DEMO=false

# Supabase (Auth + optional REST)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle / Postgres (required for db:push + seed + db:reset)
# Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=
# Or set password only (pooler URI auto-built; prefer full DATABASE_URL)
SUPABASE_DB_PASSWORD=

# Optional: skip live Deepgram/Mistral in local fixture demos
# Blocked when NODE_ENV=production unless ALLOW_DEMO_IN_PROD=true
DEMO_MODE=false
# ALLOW_DEMO_IN_PROD=false
