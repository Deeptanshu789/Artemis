# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
NODE_ENV=development

# Deepgram STT
DEEPGRAM_API_KEY=

# Gemini scoring (replaces Cursor SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Supabase (Auth + optional REST)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle / Postgres (required for db:push + seed)
# Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=
# Or set password only (pooler URI auto-built; prefer full DATABASE_URL)
SUPABASE_DB_PASSWORD=

# Optional: skip live Deepgram/Gemini in local fixture demos
DEMO_MODE=false
