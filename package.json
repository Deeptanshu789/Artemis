{
  "name": "artemis",
  "version": "1.0.0",
  "private": true,
  "description": "AI Interview Copilot — Chrome extension + dashboard for interviewer performance scoring",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @artemis/server",
    "dev:dashboard": "npm run dev -w @artemis/dashboard",
    "build:shared": "npm run build -w @artemis/shared",
    "build:server": "npm run build -w @artemis/server",
    "build:dashboard": "npm run build -w @artemis/dashboard",
    "build:extension": "npm run build -w @artemis/extension",
    "build": "npm run build:shared && npm run build:server && npm run build:dashboard && npm run build:extension",
    "start:server": "NODE_ENV=production npm run start -w @artemis/server",
    "seed": "npm run seed -w @artemis/server",
    "db:push": "npm run db:push -w @artemis/server",
    "db:reset": "npm run db:reset -w @artemis/server",
    "demo:fixture": "npm run demo:fixture -w @artemis/server",
    "check-env": "npm run check-env -w @artemis/server",
    "test": "npm run test -w @artemis/server",
    "verify": "bash scripts/verify.sh",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  }
}
