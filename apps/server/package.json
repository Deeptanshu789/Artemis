{
  "name": "@artemis/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "bash -c 'set -a && . ../../.env && set +a && drizzle-kit push --force'",
    "db:studio": "bash -c 'set -a && . ../../.env && set +a && drizzle-kit studio'",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "seed": "tsx src/scripts/seed.ts",
    "demo:fixture": "tsx src/scripts/demo-fixture.ts",
    "check-env": "tsx src/scripts/check-env.ts",
    "test": "tsx --test src/scripts/test-unit.ts"
  },
  "dependencies": {
    "@artemis/shared": "*",
    "@deepgram/sdk": "^3.11.2",
    "@google/generative-ai": "^0.24.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "express": "^4.21.2",
    "postgres": "^3.4.5",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
